# --- 必須キー ---
LINE_CHANNEL_ACCESS_TOKEN="your_line_channel_access_token_here"
LINE_CHANNEL_SECRET="your_line_channel_secret_here"
DIFY_API_KEY="your_dify_api_key_here"
OPENAI_API_KEY="your_openai_api_key_here"
DIFY_BASE_URL="https://api.dify.ai/v1/chat-messages"

# --- TTSエンジン選択 ---
# 使用するTTSエンジンを VOICEVOX, CARTESIA, STYLE_BERT_VITS2 から選択
TTS_ENGINE="VOICEVOX"

# --- 各TTSエンジンの設定 (使用するものに合わせて編集) ---

# VOICEVOX (Docker Compose使用時は voicevox-engine コンテナを参照)
VOICEVOX_BASE_URL="http://voicevox-engine:50021"
VOICEVOX_SPEAKER_ID=46  # 例: 46は「小夜/SAYO」

# Cartesia (クラウドサービス)
CARTESIA_API_KEY="your_cartesia_api_key_here"
CARTESIA_VOICE_ID="your_cartesia_voice_id_here"

# Style-Bert-VITS2 (自分で立てたAPIサーバーのアドレス)
STYLE_BERT_VITS2_BASE_URL="http://127.0.0.1:5000/voice"
