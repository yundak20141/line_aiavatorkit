# ========================================
# LINE AIAvatarKit Bot - Environment Variables
#
# 構成図:
#   [Dify Cloud] ←API→ [Docker Container] ←Webhook→ [LINE Platform]
#
# Copy this file to .env and fill in your actual API keys
# ========================================

# === LINE Messaging API (必須) ===
# LINE Developers Console (https://developers.line.biz/console/) から取得
LINE_CHANNEL_ACCESS_TOKEN="your_line_channel_access_token_here"
LINE_CHANNEL_SECRET="your_line_channel_secret_here"

# === OpenAI API (必須: STT用、LLM/TTS選択時も使用) ===
# OpenAI Platform (https://platform.openai.com/api-keys) から取得
OPENAI_API_KEY="your_openai_api_key_here"

# === LLM Selection (DIFY or CHATGPT) ===
LLM_TYPE="DIFY"

# === Dify Cloud Settings (LLM_TYPE=DIFY の場合) ===
# Dify (https://dify.ai/) のダッシュボードからAPIキーを取得
# 「アプリ」→ 対象アプリを選択 → 「APIキー」
DIFY_API_KEY="app-xxxxxxxxxxxx"
DIFY_BASE_URL="https://api.dify.ai/v1"
DIFY_USER="line_user"
DIFY_IS_AGENT_MODE="true"

# === ChatGPT Settings (LLM_TYPE=CHATGPT の場合) ===
OPENAI_MODEL="gpt-4o"
OPENAI_TEMPERATURE="0.7"

# === TTS Engine Selection ===
# OPENAI: OpenAI TTS (推奨: 追加サーバー不要)
# VOICEVOX: 日本語特化 (要: docker-compose --profile voicevox)
# CARTESIA: クラウドTTS
TTS_ENGINE="OPENAI"

# === OpenAI TTS Settings (TTS_ENGINE=OPENAI の場合・推奨) ===
OPENAI_TTS_MODEL="tts-1"
OPENAI_TTS_VOICE="nova"  # alloy, echo, fable, onyx, nova, shimmer

# === VOICEVOX Settings (TTS_ENGINE=VOICEVOX の場合) ===
# Docker Compose使用時: http://voicevox-engine:50021
# ローカル使用時: http://127.0.0.1:50021
VOICEVOX_BASE_URL="http://voicevox-engine:50021"
VOICEVOX_SPEAKER_ID="46"  # 46=小夜/SAYO

# === Cartesia TTS Settings (TTS_ENGINE=CARTESIA の場合) ===
CARTESIA_API_KEY="your_cartesia_api_key_here"
CARTESIA_VOICE_ID="your_cartesia_voice_id_here"

# === System Prompt ===
SYSTEM_PROMPT="あなたは親切で丁寧なAIアシスタントです。日本語で応答してください。"

# === WebSocket (オプション: Webブラウザからのリアルタイム対話) ===
ENABLE_WEBSOCKET="false"

# === Debug Mode ===
DEBUG="false"
